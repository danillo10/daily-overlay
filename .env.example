# Servidor web
PORT=3000
MAX_ROOM_SIZE=12

# Origens web permitidas, separadas por vírgula. Deixe vazio no desenvolvimento.
CLIENT_ORIGINS=http://localhost:5173

# URL pública do backend usada durante o build do frontend no Vercel.
VITE_API_URL=http://localhost:3000

# Produção: configure STUN + TURN para redes corporativas restritivas.
# Exemplo:
# ICE_SERVERS_JSON=[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"password"}]
ICE_SERVERS_JSON=
