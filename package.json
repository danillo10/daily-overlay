{
  "name": "daily-overlay",
  "productName": "Daily Overlay",
  "version": "1.0.0",
  "description": "Overlay de transcrição ao vivo para dailies e reuniões",
  "main": "electron/main.js",
  "author": "Daily Overlay",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && VITE_DEV_SERVER=1 electron . --no-sandbox\"",
    "web:dev": "concurrently -k \"vite\" \"node server/web-server.js\"",
    "web:start": "node server/web-server.js",
    "start": "electron . --no-sandbox",
    "build": "vite build"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.3.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^36.2.1",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
